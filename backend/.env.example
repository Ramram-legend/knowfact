# ==========================================
# KnowFact Backend Environment Variables
# ==========================================

# Secret key for JWT signing (change in production!)
SECRET_KEY=knowfact-super-secret-key-change-in-production-please

# Token expiration time in minutes (default: 24h = 1440 min)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite by default, can be PostgreSQL in production)
# DATABASE_URL=sqlite:///./knowfact.db
# DATABASE_URL=postgresql://user:password@localhost:5432/knowfact
